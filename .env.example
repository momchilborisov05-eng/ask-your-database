# Copy this file to ".env" and add your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: claude-opus-5-5 (default) or claude-sonnet-5-5 (faster, cheaper)
CLAUDE_MODEL=claude-opus-5-5

# No API key? DEMO_MODE=1 answers the example questions with SQL written in advance.
# DEMO_MODE=1

# The database to ask about (default: the sample shop.db). For Azure SQL, sign in first
# with `az login`; the app connects as you, so use an account that can only read in production.
# ASKDB_DATABASE=mssql://<server>.database.windows.net/<database>?schemas=shop
# ASKDB_CONTEXT=config/shop.md      # your business rules and definitions

# The app's audit log of every question (default: askdb.db next to app.py)
# ASKDB_STORE=sqlite:///askdb.db

# DAILY_BUDGET_USD=1.00
